# Database
DATABASE_URL=postgres://user:pass@localhost:5432/zuoran

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# App Defaults
DEFAULT_PLAYER_ID=local_dev
DEFAULT_CHARACTER_ID=zuo_ran
# DEFAULT_SESSION_THINKING=true
# DEFAULT_SESSION_TEMPERATURE=1

# Provider Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
# TAVILY_API_KEY=tvly-...

# Model Bindings
GENERATION_MODEL=anthropic:claude-sonnet-4-5
VALIDATOR_MODEL=anthropic:claude-haiku-4-5
EXTRACTOR_MODEL=deepseek:deepseek-chat
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval And Validation
# Optional override knobs. Leave commented to use the defaults in src/config/env.ts.
# Enable only when tuning retrieval, debugging rewrites, or running eval/validator experiments.
# CANON_RETRIEVAL_PIPELINE=tier3
# CANON_QUERY_HYDE=0
# USE_REWRITTEN_QUERY_FOR_MEMORY_EMBEDDING=0
# ANNOTATION_RULES_ALWAYS=0
# REWRITE_CONFIDENCE_THRESHOLD=0.6
# VALIDATOR_STRICT_ATTRIBUTION=0
# VALIDATOR_ATTRIBUTION_JUDGE_MODEL=deepseek:deepseek-chat
# CANON_LOOKUP_TOOL_ENABLED=1
# EVAL_ENABLE_LLM_JUDGE=0

# StructMem: Events And Entries
STRUCTMEM_ENABLED=true
STRUCTMEM_SUPPRESS_EXTRACTOR_SESSION_CHUNKS=true
STRUCTMEM_NATIVE_EXTRACTOR=true
# STRUCTMEM_ENTRY_RETRIEVAL_TOP_K=6

# StructMem: Current-Session Consolidation
STRUCTMEM_CONSOLIDATION_ENABLED=false
# Use EXTRACTOR_MODEL to reuse the extractor binding.
STRUCTMEM_CONSOLIDATION_MODEL=EXTRACTOR_MODEL
STRUCTMEM_MIN_UNCONSOLIDATED_TURNS=8
STRUCTMEM_MIN_UNCONSOLIDATED_ENTRIES=12
STRUCTMEM_SEED_K=5
STRUCTMEM_MAX_SEED_EVENTS=5
STRUCTMEM_MAX_ENTRIES_PER_EVENT=6
STRUCTMEM_MAX_BUFFER_ENTRIES=20
STRUCTMEM_MAX_SYNTHESIS_INPUT_TOKENS=5000
STRUCTMEM_JOB_MAX_ATTEMPTS=3

# StructMem: Cross-Session Retrieval And Writeback
STRUCTMEM_CROSS_SESSION_RETRIEVAL_ENABLED=false
STRUCTMEM_CROSS_SESSION_RETRIEVAL_TOP_K=4
STRUCTMEM_CROSS_SESSION_WRITE_ENABLED=false
STRUCTMEM_PROMOTION_TO_IME_ENABLED=false
STRUCTMEM_CROSS_SESSION_MIN_CONFIDENCE=0.75

# StructMem: Motif Probe
# Deterministic repeated-relationship-gesture detection and optional StructMem probe.
# STRUCTMEM_MOTIF_PROBE_ENABLED=false
# STRUCTMEM_MOTIF_PROBE_TOP_K=3
# STRUCTMEM_MOTIF_PROBE_MIN_SCORE=0.5
# STRUCTMEM_MOTIF_INJECT_MODE=synthesis_only

# Context Retrieval Mode
# "eager" = current behavior (all sources always retrieved).
# "hybrid_lazy" = defer heavy retrievals, gate prompt blocks on context need.
# CONTEXT_RETRIEVAL_MODE=eager
# HYBRID_LAZY_ALLOW_EMERGENCY_CANON_LOOKUP=true

# Hybrid Lazy Lookup Tools
# Generation-time lookup tools (lookup_structmem, etc.) gated behind this flag.
# GENERATION_LOOKUP_TOOLS_ENABLED=false
# GENERATION_LOOKUP_MAX_STEPS=1

# Background Jobs
# Optional post-turn worker tuning. Leave commented to use env.ts defaults.
# Controls polling frequency, worker lock TTL, and failed-job retry count.
# POST_TURN_JOB_POLL_INTERVAL_MS=5000
# POST_TURN_JOB_LOCK_TTL_MS=600000
# POST_TURN_JOB_MAX_ATTEMPTS=3

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=zuoran-chatbot-phase1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_EVAL_DATASET=zuoran-phase1-eval

# Trace metadata (attached to every LangSmith run)
TRACE_ENVIRONMENT=development
APP_VERSION=dev
GIT_SHA=unknown
TRACE_PLAYER_HASH_SALT=zuoran-local-trace-salt

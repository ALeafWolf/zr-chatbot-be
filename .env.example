# Database
DATABASE_URL=postgres://user:pass@localhost:5432/zuoran

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# App Defaults
DEFAULT_PLAYER_ID=local_dev
DEFAULT_CHARACTER_ID=zuo_ran
DEFAULT_SESSION_THINKING=true
DEFAULT_SESSION_TEMPERATURE=1

# Provider Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
# TAVILY_API_KEY=tvly-...

# Model Bindings
GENERATION_MODEL=anthropic:claude-sonnet-4-5

# DeepSeek V4 Thinking Marker
# Generation-only thinking-mode marker for deepseek:deepseek-v4-pro.
# Allowed values: default, inner_os, no_inner_os. Set to inner_os or no_inner_os to enable.
DEEPSEEK_V4_THINKING_MODE=default
# When false, native DeepSeek reasoning thoughts are hidden from the user.
SHOW_NATIVE_REASONING_EVENTS=false
# Marker injection scope: first_turn_only or every_generation (default).
# Use every_generation if first-turn-only effect diminishes after several turns.
# DEEPSEEK_V4_THINKING_MARKER_SCOPE=every_generation

VALIDATOR_MODEL=deepseek:deepseek-v4-pro
EXTRACTOR_MODEL=deepseek:deepseek-v4-flash
VALIDATOR_ATTRIBUTION_JUDGE_MODEL=deepseek:deepseek-v4-pro
VALIDATOR_ATTRIBUTION_JUDGE_FALLBACK_MODEL=openai:gpt-5-mini
CLASSIFY_TURN_ROUTE_FALLBACK_MODEL=openai:gpt-5-nano
QUERY_REWRITE_FALLBACK_MODEL=openai:gpt-5-nano
RECALL_THOUGHT_FALLBACK_MODEL=openai:gpt-5-nano
RESPONSE_VALIDATOR_FALLBACK_MODEL=openai:gpt-5-mini
MEMORY_DEDUP_JUDGE_FALLBACK_MODEL=openai:gpt-5-mini
POST_TURN_EXTRACTOR_FALLBACK_MODEL=openai:gpt-5-mini # Also drives session-summary-merger fallover
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval And Validation
# Optional override knobs. Leave commented to use the defaults in src/config/env.ts.
# Enable only when tuning retrieval, debugging rewrites, or running eval/validator experiments.
CANON_RETRIEVAL_PIPELINE=tier3
CANON_QUERY_HYDE=0
USE_REWRITTEN_QUERY_FOR_MEMORY_EMBEDDING=0
ANNOTATION_RULES_ALWAYS=0
REWRITE_CONFIDENCE_THRESHOLD=0.6
VALIDATOR_STRICT_ATTRIBUTION=0
CANON_LOOKUP_TOOL_ENABLED=1
EVAL_ENABLE_LLM_JUDGE=0

# StructMem: Events And Entries
STRUCTMEM_ENABLED=true
STRUCTMEM_SUPPRESS_EXTRACTOR_SESSION_CHUNKS=true
STRUCTMEM_NATIVE_EXTRACTOR=true
# STRUCTMEM_ENTRY_RETRIEVAL_TOP_K=6

# StructMem: Current-Session Consolidation
STRUCTMEM_CONSOLIDATION_ENABLED=false
STRUCTMEM_CONSOLIDATION_MODEL=deepseek:deepseek-v4-pro
STRUCTMEM_CONSOLIDATION_FALLBACK_MODEL=openai:gpt-5-mini
STRUCTMEM_MIN_UNCONSOLIDATED_TURNS=8
STRUCTMEM_MIN_UNCONSOLIDATED_ENTRIES=12
STRUCTMEM_SEED_K=5
STRUCTMEM_MAX_SEED_EVENTS=5
STRUCTMEM_MAX_ENTRIES_PER_EVENT=6
STRUCTMEM_MAX_BUFFER_ENTRIES=20
STRUCTMEM_MAX_SYNTHESIS_INPUT_TOKENS=5000
STRUCTMEM_JOB_MAX_ATTEMPTS=3

# StructMem: Cross-Session Retrieval And Writeback
STRUCTMEM_CROSS_SESSION_RETRIEVAL_ENABLED=false
STRUCTMEM_CROSS_SESSION_RETRIEVAL_TOP_K=4
STRUCTMEM_CROSS_SESSION_WRITE_ENABLED=false
STRUCTMEM_PROMOTION_TO_IME_ENABLED=false
STRUCTMEM_CROSS_SESSION_MIN_CONFIDENCE=0.75

# StructMem: Motif Probe
# Deterministic repeated-relationship-gesture detection and optional StructMem probe.
STRUCTMEM_MOTIF_PROBE_ENABLED=false
STRUCTMEM_MOTIF_PROBE_TOP_K=3
STRUCTMEM_MOTIF_PROBE_MIN_SCORE=0.5
STRUCTMEM_MOTIF_INJECT_MODE=synthesis_only

# Memory Rerank
# Model binding for the LLM that judges which retrieved context to inject.
# Use EXTRACTOR_MODEL to reuse the extractor binding.
MEMORY_RERANK_MODEL=deepseek:deepseek-v4-flash
MEMORY_RERANK_FALLBACK_MODEL=openai:gpt-5-mini
MEMORY_RERANK_MAX_CANDIDATES=24
MEMORY_RERANK_MAX_SELECTED=8
STRUCTMEM_CROSS_SESSION_DISTILLATION_FALLBACK_MODEL=openai:gpt-5-mini

# Background Jobs
# Optional post-turn worker tuning. Leave commented to use env.ts defaults.
# Controls polling frequency, worker lock TTL, and failed-job retry count.
POST_TURN_JOB_POLL_INTERVAL_MS=5000
POST_TURN_JOB_LOCK_TTL_MS=600000
POST_TURN_JOB_MAX_ATTEMPTS=3

# Roleplay Graph Stream
# When true, roleplay turns use the graph-backed stream adapter
# (disabled by default -- the existing direct stream path remains the default).
ROLEPLAY_GRAPH_STREAM_ENABLED=false

# Emotional Engine
# Session-local emotional-axis engine (axis baselines, drift, couplings). When enabled,
# advances character state after each turn and persists axis state, traces, and band
# history in session_state. Defaults OFF.
# REQUIRED (=true) for the emotional-axis eval to capture update-side snapshots — with the
# engine off, agent_turn rows produce empty emotionalAxis snapshots.
EMOTIONAL_ENGINE_ENABLED=false
# Injects an axis-band behavior-grammar block into the prompt based on engine state.
# Requires EMOTIONAL_ENGINE_ENABLED=true. Defaults OFF. Set =true for the render-side
# emotional-axis eval (render snapshots / render_* assertions).
EMOTIONAL_RENDER_ENABLED=false

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=zuoran-chatbot-phase1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_EVAL_DATASET=zuoran-phase1-eval
# Dedicated dataset for the emotional-axis scenario set (npm run eval:emotional-axis:push).
# Defaults to `emotional-axis-${LANGSMITH_EVAL_DATASET}`.
# NOTE: the experiment runner reads LANGSMITH_EVAL_DATASET, NOT this var — to run
# `eval:emotional-axis:langsmith`, point LANGSMITH_EVAL_DATASET at this dataset for the run.
# LANGSMITH_EMOTIONAL_AXIS_EVAL_DATASET=emotional-axis-zuoran-phase1-eval

# Trace metadata (attached to every LangSmith run)
TRACE_ENVIRONMENT=development
APP_VERSION=dev
GIT_SHA=unknown
TRACE_PLAYER_HASH_SALT=zuoran-local-trace-salt

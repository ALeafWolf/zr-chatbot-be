# Shared with scene-ingestor/script-extractor — same zuoran database
DATABASE_URL=postgres://user:pass@localhost:5432/zuoran

# LLM provider keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# Optional web search (Tavily). If unset, the web_search tool reports unavailable.
# TAVILY_API_KEY=tvly-...

# Per-task model bindings (provider:model format)
GENERATION_MODEL=anthropic:claude-sonnet-4-5
VALIDATOR_MODEL=anthropic:claude-haiku-4-5
EXTRACTOR_MODEL=deepseek:deepseek-chat
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# StructMem Phase 1/2.
STRUCTMEM_ENABLED=true
# When StructMem is on, skip duplicate extractor rows in session_memory_chunks (raw turn pairs unchanged).
STRUCTMEM_SUPPRESS_EXTRACTOR_SESSION_CHUNKS=true
# When StructMem is on, persist structmem_entries from the extractor JSON instead of mapping memory_candidates (Phase 2).
STRUCTMEM_NATIVE_EXTRACTOR=true
# Top-K semantic hits for structmem_entries (same recent-window cutoff as session recall).
# STRUCTMEM_ENTRY_RETRIEVAL_TOP_K=6

# StructMem Phase 3 current-session consolidation.
STRUCTMEM_CONSOLIDATION_ENABLED=false
STRUCTMEM_CONSOLIDATION_MODEL=EXTRACTOR_MODEL
STRUCTMEM_MIN_UNCONSOLIDATED_TURNS=8
STRUCTMEM_MIN_UNCONSOLIDATED_ENTRIES=12
STRUCTMEM_SEED_K=5
STRUCTMEM_MAX_SEED_EVENTS=5
STRUCTMEM_MAX_ENTRIES_PER_EVENT=6
STRUCTMEM_MAX_BUFFER_ENTRIES=20
STRUCTMEM_MAX_SYNTHESIS_INPUT_TOKENS=5000
STRUCTMEM_JOB_MAX_ATTEMPTS=3

# canon_lookup tool (default on; set 0/false/off to disable).
# CANON_LOOKUP_TOOL_ENABLED=1

# Optional: require LLM attribution judge + stronger rewrite path (default off).
# VALIDATOR_STRICT_ATTRIBUTION=0

# Optional: model for attribution judge (defaults to EXTRACTOR_MODEL).
# VALIDATOR_ATTRIBUTION_JUDGE_MODEL=deepseek:deepseek-chat

# LangSmith observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=zuoran-chatbot-phase1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# App defaults
DEFAULT_PLAYER_ID=local_dev
DEFAULT_CHARACTER_ID=zuo_ran
# Optional: default reasoning on for new sessions when POST body omits `thinking`.
# DEFAULT_SESSION_THINKING=false
